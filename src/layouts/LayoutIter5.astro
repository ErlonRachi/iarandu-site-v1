---
import "../styles/global.css";
import "../styles/iter5.css";
import StickyHeader from "../components/StickyHeader.v4.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Iarandu — a camada de IA que sua área de negócio precisa",
  description = "Construímos a camada de IA que sua área de negócio precisa. Em parceria com a TI da empresa, sem disputar atenção.",
  noindex = true,
} = Astro.props;

const canonicalHref = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Inter+Tight:wght@400;500;600;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Inter+Tight:wght@400;500;600;800&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta name="theme-color" content="#0E1A26" />

    <title>{title}</title>
  </head>
  <body>
    <StickyHeader />
    <div class="iter5">
      <slot />
    </div>

    <script>
      document.querySelectorAll<HTMLElement>("[data-words]").forEach((el) => {
        const text = el.textContent ?? "";
        const children = Array.from(el.childNodes);
        el.textContent = "";
        let wordIndex = 0;
        children.forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const parts = (node.textContent ?? "").split(/(\s+)/);
            parts.forEach((part) => {
              if (part.trim().length === 0) {
                el.appendChild(document.createTextNode(part));
              } else {
                const span = document.createElement("span");
                span.className = "word";
                span.style.setProperty("--i", String(wordIndex++));
                span.textContent = part;
                el.appendChild(span);
              }
            });
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            const span = document.createElement("span");
            span.className = "word";
            span.style.setProperty("--i", String(wordIndex++));
            span.appendChild(node);
            el.appendChild(span);
          }
        });
        void text;
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );

      document
        .querySelectorAll(".reveal, [data-words], [data-curve], .role-cloud")
        .forEach((el) => io.observe(el));
    </script>
  </body>
</html>
