---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Iarandu — a camada de IA que sua área de negócio precisa",
  description = "Construímos a camada de IA e dados que as áreas de negócio das empresas precisam — em parceria com a TI delas, sem entrar na fila delas.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Inter+Tight:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,700&family=Inter+Tight:wght@400;500;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="theme-color" content="#0E1A26" />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      // Split [data-words] elements into per-word spans for typographic stagger.
      // Done before observing so the IO trigger reaches the spans, not the host.
      document.querySelectorAll<HTMLElement>("[data-words]").forEach((el) => {
        const text = el.textContent ?? "";
        // Preserve any inline accent spans by rebuilding from existing children.
        const children = Array.from(el.childNodes);
        el.textContent = "";
        let wordIndex = 0;
        children.forEach((node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const parts = (node.textContent ?? "").split(/(\s+)/);
            parts.forEach((part) => {
              if (part.trim().length === 0) {
                el.appendChild(document.createTextNode(part));
              } else {
                const span = document.createElement("span");
                span.className = "word";
                span.style.setProperty("--i", String(wordIndex++));
                span.textContent = part;
                el.appendChild(span);
              }
            });
          } else if (node.nodeType === Node.ELEMENT_NODE) {
            // For inline accent <span class="accent-*">word</span>, treat as one word.
            const span = document.createElement("span");
            span.className = "word";
            span.style.setProperty("--i", String(wordIndex++));
            span.appendChild(node);
            el.appendChild(span);
          }
        });
        void text; // satisfies linter — kept for clarity
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );

      document
        .querySelectorAll(".reveal, [data-words], [data-curve], .role-cloud")
        .forEach((el) => io.observe(el));
    </script>
  </body>
</html>
