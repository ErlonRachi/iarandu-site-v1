---
// Section 10 (v6) — surface-4 (deepest). Keyword: "Amazonas" (urucum).
// Diff vs v5: substitui CTA único (mailto) por formulário roteado por tipo de
// problema (6 botões → email/mensagem → POST /api/lead). Mailto preservado
// como fallback nos estados de erro/sucesso. Backend: netlify/functions/lead.ts.
import { FUNNEL_OPTIONS } from "../../data/funnel-options";

const MAILTO_TO = "we@iarandu.tech";
const mailtoHref = `mailto:${MAILTO_TO}?subject=${encodeURIComponent("Conversa com a Iarandu")}&body=${encodeURIComponent("Olá,\n\n")}`;
---

<section id="vamos" class="surface-4 section-pad" aria-labelledby="fechamento-title">
  <div class="container-narrow">
    <h2 id="fechamento-title" class="display-xl measure-manifesto" data-words>
      Somos como o Rio <span class="accent-urucum">Amazonas</span> correndo pro mar.
    </h2>

    <p class="reveal mt-[32px] md:mt-[48px] body-lg measure-tight" style="transition-delay: 200ms;">
      Conta pra gente o que está em sua mente! Clica nos botões abaixo ou nos escreva direto <a class="link-editorial" href={mailtoHref}>{MAILTO_TO}</a>
    </p>

    <div
      class="reveal lead-form mt-[48px] md:mt-[64px]"
      style="transition-delay: 320ms;"
      data-lead-form
      data-state="idle"
    >
      <h3 class="h2 lead-form__prompt">
        Onde tá o nó que você quer destravar?
      </h3>

      <div
        class="lead-form__options"
        role="radiogroup"
        aria-labelledby="fechamento-prompt-label"
        data-options
      >
        <span id="fechamento-prompt-label" class="sr-only">
          Selecione o tipo de problema que você quer resolver
        </span>
        {FUNNEL_OPTIONS.map((opt, i) => (
          <button
            type="button"
            class="lead-form__option"
            role="radio"
            aria-checked="false"
            data-slug={opt.slug}
            data-index={i}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="lead-form__option-label">{opt.label}</span>
          </button>
        ))}
      </div>

      <form
        class="lead-form__inline"
        data-inline-form
        novalidate
        aria-hidden="true"
      >
        <input type="hidden" name="tipoProblema" data-tipo-problema value="" />

        <div class="lead-form__field">
          <label for="lead-email" class="lead-form__label">Seu email</label>
          <input
            id="lead-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="voce@empresa.com"
            class="lead-form__input"
            aria-describedby="lead-email-help"
          />
          <span id="lead-email-help" class="sr-only">
            Usaremos só pra responder você.
          </span>
        </div>

        <div class="lead-form__field">
          <label for="lead-mensagem" class="lead-form__label">
            Conte rápido <span class="lead-form__optional">(opcional)</span>
          </label>
          <textarea
            id="lead-mensagem"
            name="mensagem"
            rows="3"
            maxlength="240"
            placeholder="Em uma frase: qual o cenário?"
            class="lead-form__textarea"
            aria-describedby="lead-mensagem-help"
          ></textarea>
          <span id="lead-mensagem-help" class="lead-form__char">
            <span data-char-count>0</span>/240
          </span>
        </div>

        <div class="lead-form__hp" aria-hidden="true">
          <label for="lead-hp">Não preencha este campo</label>
          <input
            id="lead-hp"
            name="_hp"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <div class="lead-form__actions">
          <button type="submit" class="cta-primary" data-submit>
            <span data-submit-label>enviar</span>
          </button>
        </div>

        <p class="lead-form__lgpd body-sm">
          Ao enviar, você autoriza o time da Iarandu a entrar em contato. Não usamos
          pra mais nada, não compartilhamos.
        </p>
      </form>

      <div class="lead-form__result lead-form__result--success" data-success aria-live="polite">
        <p class="lead-form__result-title">Recebemos.</p>
        <p class="body-lg lead-form__result-body">
          Eduardo responde em até 1 dia útil.
        </p>
        <p class="body-sm lead-form__result-tail">
          Se preferir, escreva direto: <a class="link-editorial" href={mailtoHref}>{MAILTO_TO}</a>
        </p>
      </div>

      <div class="lead-form__result lead-form__result--error" data-error aria-live="assertive">
        <p class="lead-form__result-title">Algo travou.</p>
        <p class="body-lg lead-form__result-body">
          Escreva pra <a class="link-editorial" href={mailtoHref}>{MAILTO_TO}</a> ou tente de novo.
        </p>
        <div class="lead-form__actions">
          <button type="button" class="cta-primary" data-retry>tentar de novo</button>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lead-form__prompt {
    margin-bottom: 28px;
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .lead-form__prompt { margin-bottom: 36px; }
  }

  .lead-form__options {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 560px) {
    .lead-form__options {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
  }

  @media (min-width: 900px) {
    .lead-form__options {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 16px;
    }
  }

  .lead-form__option {
    appearance: none;
    background: rgba(241, 236, 224, 0.025);
    border: 1px solid var(--linha-papel);
    border-radius: 2px;
    color: var(--ink);
    font-family: inherit;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.003em;
    text-align: left;
    padding: 22px 22px;
    min-height: 96px;
    cursor: pointer;
    transition:
      background-color 220ms var(--ease),
      border-color 220ms var(--ease),
      opacity 280ms var(--ease),
      transform 220ms var(--ease);
    will-change: background-color, border-color, opacity;
  }

  @media (min-width: 768px) {
    .lead-form__option {
      padding: 24px 24px;
      font-size: 17px;
    }
  }

  .lead-form__option:hover {
    border-color: var(--linha-papel-strong);
    background: rgba(241, 236, 224, 0.045);
  }

  .lead-form__option[aria-checked="true"] {
    border-color: var(--urucum);
    background: rgba(194, 94, 58, 0.08);
  }

  .lead-form[data-state="selected"] .lead-form__option:not([aria-checked="true"]),
  .lead-form[data-state="submitting"] .lead-form__option:not([aria-checked="true"]) {
    opacity: 0.4;
  }

  .lead-form[data-state="selected"] .lead-form__option:not([aria-checked="true"]):hover,
  .lead-form[data-state="submitting"] .lead-form__option:not([aria-checked="true"]):hover {
    opacity: 0.7;
  }

  .lead-form__option-label {
    display: block;
  }

  .lead-form__inline {
    margin-top: 32px;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition:
      opacity 280ms var(--ease),
      max-height 360ms var(--ease),
      margin-top 280ms var(--ease);
  }

  .lead-form[data-state="selected"] .lead-form__inline,
  .lead-form[data-state="submitting"] .lead-form__inline {
    opacity: 1;
    max-height: 800px;
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .lead-form[data-state="selected"] .lead-form__inline,
    .lead-form[data-state="submitting"] .lead-form__inline {
      margin-top: 56px;
    }
  }

  .lead-form__field {
    margin-bottom: 22px;
  }

  .lead-form__label {
    display: block;
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }

  .lead-form__optional {
    color: var(--ink-muted);
    font-weight: 400;
  }

  .lead-form__input,
  .lead-form__textarea {
    width: 100%;
    background: rgba(241, 236, 224, 0.04);
    border: 1px solid var(--linha-papel);
    border-radius: 2px;
    color: var(--ink);
    font-family: inherit;
    font-size: 17px;
    line-height: 1.5;
    padding: 14px 16px;
    transition: border-color 180ms var(--ease), background-color 180ms var(--ease);
  }

  .lead-form__textarea {
    resize: vertical;
    min-height: 96px;
  }

  .lead-form__input:hover,
  .lead-form__textarea:hover {
    border-color: var(--linha-papel-strong);
  }

  .lead-form__input:focus,
  .lead-form__textarea:focus {
    outline: none;
    border-color: var(--urucum);
    background: rgba(241, 236, 224, 0.06);
  }

  .lead-form__input::placeholder,
  .lead-form__textarea::placeholder {
    color: var(--ink-muted);
  }

  .lead-form__char {
    display: block;
    text-align: right;
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-muted);
    font-feature-settings: "tnum";
  }

  .lead-form__hp {
    display: none;
  }

  .lead-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }

  .lead-form__back {
    background: transparent;
    border: 0;
    padding: 6px 0;
    font: inherit;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .lead-form__lgpd {
    margin-top: 20px;
    color: var(--ink-muted);
  }

  .lead-form__result {
    display: none;
    margin-top: 8px;
  }

  .lead-form[data-state="success"] .lead-form__result--success,
  .lead-form[data-state="error"] .lead-form__result--error {
    display: block;
  }

  .lead-form[data-state="success"] .lead-form__options,
  .lead-form[data-state="success"] .lead-form__inline,
  .lead-form[data-state="success"] .lead-form__prompt,
  .lead-form[data-state="error"] .lead-form__options,
  .lead-form[data-state="error"] .lead-form__inline,
  .lead-form[data-state="error"] .lead-form__prompt {
    display: none;
  }

  .lead-form__result-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.12;
    letter-spacing: -0.012em;
    color: var(--ink);
    margin-bottom: 16px;
  }

  .lead-form__result--success .lead-form__result-title {
    color: var(--verde-folha);
  }

  .lead-form__result--error .lead-form__result-title {
    color: var(--urucum-fresh);
  }

  .lead-form__result-body {
    margin-bottom: 12px;
  }

  .lead-form__result-tail {
    color: var(--ink-muted);
  }

  .lead-form[data-state="submitting"] [data-submit] {
    pointer-events: none;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .lead-form__option,
    .lead-form__inline,
    .lead-form__input,
    .lead-form__textarea {
      transition: none;
    }
  }
</style>

<script>
  type State = "idle" | "selected" | "submitting" | "success" | "error";

  interface LeadResponse {
    ok?: boolean;
    error?: string;
    details?: string;
  }

  document.querySelectorAll<HTMLElement>("[data-lead-form]").forEach((root) => {
    const options = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".lead-form__option"),
    );
    const form = root.querySelector<HTMLFormElement>("[data-inline-form]");
    const tipoInput = root.querySelector<HTMLInputElement>("[data-tipo-problema]");
    const emailInput = root.querySelector<HTMLInputElement>("#lead-email");
    const mensagemInput = root.querySelector<HTMLTextAreaElement>("#lead-mensagem");
    const charCount = root.querySelector<HTMLElement>("[data-char-count]");
    const submitBtn = root.querySelector<HTMLButtonElement>("[data-submit]");
    const submitLabel = root.querySelector<HTMLElement>("[data-submit-label]");
    const retryBtn = root.querySelector<HTMLButtonElement>("[data-retry]");
    const hpInput = root.querySelector<HTMLInputElement>("#lead-hp");

    if (!form || !tipoInput || !emailInput || !mensagemInput || !submitBtn || !submitLabel || !retryBtn || !hpInput) {
      return;
    }

    const setState = (s: State) => {
      root.dataset.state = s;
      if (form) {
        form.setAttribute("aria-hidden", s === "selected" || s === "submitting" ? "false" : "true");
      }
    };

    const selectOption = (slug: string, focusEmail: boolean) => {
      tipoInput.value = slug;
      options.forEach((btn) => {
        const isMatch = btn.dataset.slug === slug;
        btn.setAttribute("aria-checked", String(isMatch));
        btn.tabIndex = isMatch ? 0 : -1;
      });
      setState("selected");
      if (focusEmail) {
        window.requestAnimationFrame(() => emailInput.focus({ preventScroll: false }));
      }
    };

    options.forEach((btn, i) => {
      btn.addEventListener("click", () => {
        const slug = btn.dataset.slug;
        if (!slug) return;
        const wasIdle = root.dataset.state === "idle";
        selectOption(slug, wasIdle);
      });

      btn.addEventListener("keydown", (e) => {
        const key = e.key;
        if (key !== "ArrowRight" && key !== "ArrowLeft" && key !== "ArrowDown" && key !== "ArrowUp") return;
        e.preventDefault();
        const delta = key === "ArrowRight" || key === "ArrowDown" ? 1 : -1;
        const next = (i + delta + options.length) % options.length;
        const target = options[next];
        if (!target) return;
        target.focus();
        const slug = target.dataset.slug;
        if (slug) selectOption(slug, false);
      });
    });

    mensagemInput.addEventListener("input", () => {
      if (charCount) charCount.textContent = String(mensagemInput.value.length);
    });

    const submit = async (): Promise<void> => {
      if (!emailInput.checkValidity()) {
        emailInput.reportValidity();
        return;
      }
      if (!tipoInput.value) return;

      const previousLabel = submitLabel.textContent ?? "enviar";
      submitLabel.textContent = "enviando…";
      setState("submitting");

      const payload = {
        tipoProblema: tipoInput.value,
        email: emailInput.value.trim(),
        mensagem: mensagemInput.value.trim(),
        origem: window.location.href,
        _hp: hpInput.value,
      };

      try {
        const res = await fetch("/api/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as LeadResponse;
        if (res.ok && body.ok) {
          setState("success");
        } else {
          setState("error");
        }
      } catch {
        setState("error");
      } finally {
        submitLabel.textContent = previousLabel;
      }
    };

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      void submit();
    });

    retryBtn.addEventListener("click", () => {
      setState("selected");
    });
  });
</script>
