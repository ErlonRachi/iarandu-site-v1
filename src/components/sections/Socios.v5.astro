  {
    nome: "Eduardo Campos",
    apelido: "Duda",
    papel: "Produtos digitais e IA",
    bio: "Mercado Libre, Coca-Cola, Centauro, CI&T. Nosso especialista em produtos digitais e de IA.",
    linkedin: "https://www.linkedin.com/in/dudacampos/",
    illustration: "duda",
  },
  {
    nome: "Mauro Resende",
    papel: "Infraestrutura, cloud, segurança",
    bio: "+10 anos no Google Cloud LATAM. CTO de startups brasileiras antes da Iarandu. Nosso especialista em infraestrutura, cloud e segurança.",
    linkedin: "https://www.linkedin.com/in/mauronr",
    illustration: "mauro",
  },
  {
    nome: "Erlon Rachi",
    papel: "Dados, ML, governança e IA",
    bio: "Carreira em Ford, CI&T, Kaizen Gaming. Cientista de dados, expert em Dados, Machine Learning, Governança e IA.",
    linkedin: "https://www.linkedin.com/in/erlonrachi/",
    illustration: "erlon",
  },
];

// Role chips — humanos + IA, mistos. AI reduzido a 3 termos legíveis pra
// Marina (não-CTO). Cortados: RAG retriever, embedding service, model
// orchestrator, code assistant, agente autônomo, Sonnet, Claude Code.
type Chip = { text: string; ai?: boolean };
const chips: Chip[] = [
  { text: "desenvolvedores" },
  { text: "Claude", ai: true },
  { text: "matemático" },
  { text: "produtos digitais" },
  { text: "agentes", ai: true },
  { text: "designer de processos" },
  { text: "cientista de dados" },
  { text: "engenheiro de software" },
  { text: "modelos de linguagem", ai: true },
  { text: "arquiteto de soluções" },
  { text: "DevOps engineer" },
  { text: "QA engineer" },
  { text: "consultor" },
];

const origens = ["Nestlé", "Coca-Cola", "Google Cloud", "CI&T", "Mercado Libre", "Ford Motor"];
