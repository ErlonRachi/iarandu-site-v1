---
interface Props {
  current: "a" | "b" | "c";
}
const { current } = Astro.props;

const variants = [
  { id: "a", href: "/", label: "A — Editorial" },
  { id: "b", href: "/b", label: "B — Klim/Linear" },
  { id: "c", href: "/c", label: "C — Bulcão" },
];
---

<nav
  aria-label="Trocar de variante"
  style="position: fixed; top: 16px; right: 16px; z-index: 50; display: flex; gap: 4px; padding: 6px; background: rgba(15, 22, 30, 0.82); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-radius: 999px; font-family: 'Inter Tight', system-ui, sans-serif; font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase;"
>
  {
    variants.map((v) => (
      <a
        href={v.href}
        aria-current={v.id === current ? "page" : undefined}
        style={`padding: 6px 12px; border-radius: 999px; text-decoration: none; transition: background-color 180ms cubic-bezier(0.22,1,0.36,1); ${v.id === current ? "background: #C25E3A; color: #F1ECE0;" : "background: transparent; color: #F1ECE0; opacity: 0.75;"}`}
      >
        {v.label}
      </a>
    ))
  }
</nav>
