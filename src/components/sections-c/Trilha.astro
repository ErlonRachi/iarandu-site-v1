---
const passagens = ["Nestlé", "Coca-Cola", "Google Cloud", "CI&T", "Mercado Libre"];
---

<section class="c-tile c-tile-papel-soft c-pad-tight" aria-labelledby="c-trilha">
  <div class="c-container">
    <div
      style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 32px; align-items: baseline;"
    >
      <div style="grid-column: 1 / span 4;">
        <p class="c-label c-reveal" style="opacity: 0.55;">trajetória</p>
        <h2 id="c-trilha" class="c-h2 c-reveal" style="margin-top: 16px;">
          Onde os fundadores já estiveram.
        </h2>
      </div>
      <ul
        class="c-reveal"
        style="grid-column: 6 / -1; display: flex; flex-wrap: wrap; gap: 24px 48px; transition-delay: 120ms;"
      >
        {
          passagens.map((p) => (
            <li class="c-display-lg" style="font-size: clamp(22px, 2.4vw, 36px);">
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
