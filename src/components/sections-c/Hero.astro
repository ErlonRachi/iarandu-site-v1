---
import Logo from "../Logo.astro";
---

<section class="c-tile c-tile-urucum c-pad" aria-labelledby="c-hero">
  <div class="c-container">
    <header style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 88px;">
      <a
        href="#topo"
        id="topo"
        aria-label="Iarandu"
        style="color: var(--c-papel); display: inline-flex;"
      >
        <Logo variant="full" width={170} />
      </a>
      <a href="#c-vamos" class="c-link c-label" style="text-decoration: none;">vamos.</a>
    </header>

    <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px;">
      <h1
        id="c-hero"
        class="c-display-xxl c-reveal c-bleed-left"
        style="grid-column: 1 / span 12;"
      >
        Construímos a camada de IA que sua área de negócio
        <span class="c-display-italic" style="display: inline; color: var(--c-papel);">precisa</span>.
      </h1>

      <p
        class="c-body-lg c-reveal"
        style="grid-column: 1 / span 7; margin-top: 64px; transition-delay: 200ms; opacity: 0.94;"
      >
        Em parceria com a TI da empresa. Seguindo os padrões dela. Saímos do
        orçamento da área de negócio.
      </p>

      <p
        class="c-label c-reveal"
        style="grid-column: 9 / span 4; margin-top: 64px; align-self: end; transition-delay: 320ms;"
      >
        Sem entrar na fila da TI.
      </p>
    </div>
  </div>
</section>
