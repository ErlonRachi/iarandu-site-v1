---
---

<section id="c-vamos" class="c-tile c-tile-urucum c-pad" aria-labelledby="c-fechamento">
  <div class="c-container">
    <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 32px; align-items: end;">
      <h2
        id="c-fechamento"
        class="c-display-xxl c-reveal c-bleed-left"
        style="grid-column: 1 / span 12;"
      >
        Somos como o
        <span class="c-display-italic" style="display: inline;">Rio Amazonas</span>
        correndo pro mar.
      </h2>
    </div>

    <p
      class="c-body-lg c-reveal"
      style="margin-top: 48px; max-width: 50ch; transition-delay: 200ms; opacity: 0.92;"
    >
      Não dá para parar. Quer ver onde a sua área de negócio entra no curso?
    </p>

    <form
      class="c-reveal"
      style="margin-top: 96px; max-width: 36rem; display: grid; gap: 32px;"
      method="get"
      action="mailto:we@iarandu.tech"
      enctype="text/plain"
    >
      <div>
        <label for="c-nome" class="c-label">nome</label>
        <input id="c-nome" name="nome" type="text" required autocomplete="name" class="c-input" />
      </div>
      <div>
        <label for="c-empresa" class="c-label">empresa</label>
        <input id="c-empresa" name="empresa" type="text" required autocomplete="organization" class="c-input" />
      </div>
      <div>
        <label for="c-desafio" class="c-label">desafio em uma frase</label>
        <input id="c-desafio" name="desafio" type="text" required maxlength="240" class="c-input" />
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="c-cta">vamos.</button>
      </div>
    </form>

    <p
      class="c-body-sm"
      style="margin-top: 40px; opacity: 0.85;"
    >
      Ou direto: <a class="c-link" href="mailto:we@iarandu.tech">we@iarandu.tech</a>
    </p>
  </div>
</section>
