---
interface Props {
  variant?: "full" | "mark";
  width?: number | string;
  ariaLabel?: string;
  class?: string;
  animate?: boolean;
}

const {
  variant = "full",
  width = variant === "full" ? 280 : 56,
  ariaLabel = variant === "full" ? "iarandu" : "iarandu mark",
  class: className = "",
  animate = false,
} = Astro.props;

const cls = `${animate ? "logo-bloom " : ""}${className}`.trim();
---

{
  variant === "full" ? (
    <svg
      viewBox="0 0 880 240"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={ariaLabel}
      width={width}
      class={cls}
    >
      <title>{ariaLabel}</title>
      <style>{`
        .iarandu-wordmark {
          font-family: 'Inter Tight', system-ui, -apple-system, sans-serif;
          font-weight: 800;
          font-size: 200px;
          letter-spacing: -0.04em;
        }
      `}</style>

      <g transform="translate(132, 124)">
        <ellipse class="orbit orbit-1" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" transform="rotate(-32)" />
        <ellipse class="orbit orbit-2" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" />
        <ellipse class="orbit orbit-3" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" transform="rotate(32)" />
        <circle class="planet" cx="83" cy="-48" r="13" fill="#C25E3A" />
      </g>

      <g class="wordmark-group">
        <text x="278" y="194" class="iarandu-wordmark" fill="currentColor">ıarandu</text>
      </g>
      <circle class="tittle" cx="316" cy="58" r="13" fill="#C25E3A" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 240 240"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={ariaLabel}
      width={width}
      class={cls}
    >
      <title>{ariaLabel}</title>
      <g transform="translate(120, 120)">
        <ellipse class="orbit orbit-1" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" transform="rotate(-32)" />
        <ellipse class="orbit orbit-2" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" />
        <ellipse class="orbit orbit-3" pathLength="100" rx="96" ry="32" fill="none" stroke="currentColor" stroke-width="5" transform="rotate(32)" />
        <circle class="planet" cx="83" cy="-48" r="13" fill="#C25E3A" />
      </g>
    </svg>
  )
}
