---
---

<section id="b-vamos" class="b-section b-surface-deep" aria-labelledby="b-fechamento">
  <div class="b-container b-grid">
    <header class="b-section-header" style="grid-column: 1 / -1;">
      <span class="b-section-num">§09</span>
      <span class="b-label">contato</span>
    </header>

    <h2 id="b-fechamento" class="b-display-xxl b-reveal" style="grid-column: 1 / span 9;">
      Somos como o Rio Amazonas correndo pro mar.
    </h2>

    <p
      class="b-body-lg b-reveal"
      style="grid-column: 1 / span 7; margin-top: 32px; transition-delay: 200ms;"
    >
      Não dá para parar. Quer ver onde a sua área de negócio entra no curso?
    </p>

    <form
      class="b-reveal"
      style="grid-column: 1 / span 7; margin-top: 80px; display: grid; gap: 24px;"
      method="get"
      action="mailto:we@iarandu.tech"
      enctype="text/plain"
    >
      <div style="display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: baseline;">
        <label for="b-nome" class="b-label">nome</label>
        <input id="b-nome" name="nome" type="text" required autocomplete="name" class="b-input" />
      </div>
      <div style="display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: baseline;">
        <label for="b-empresa" class="b-label">empresa</label>
        <input id="b-empresa" name="empresa" type="text" required autocomplete="organization" class="b-input" />
      </div>
      <div style="display: grid; grid-template-columns: 140px 1fr; gap: 24px; align-items: baseline;">
        <label for="b-desafio" class="b-label">desafio em 1 frase</label>
        <input id="b-desafio" name="desafio" type="text" required maxlength="240" class="b-input" />
      </div>

      <div style="margin-top: 16px;">
        <button type="submit" class="b-cta">vamos.</button>
      </div>
    </form>

    <p
      class="b-body-sm"
      style="grid-column: 1 / span 7; margin-top: 32px;"
    >
      Ou direto: <a class="b-link" href="mailto:we@iarandu.tech">we@iarandu.tech</a>
    </p>
  </div>
</section>
